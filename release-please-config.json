{
    "release-as": "6.4.0",
    "packages": {
        "es-ds-styles": {},
        "es-ds-components": {},
        "es-ds-docs": {
            "exclude-paths": ["es-ds-docs"],
            "skip-changelog": true
        }
    },
    "plugins": [
        {
            "type": "node-workspace",
            "merge": false
        },
        {
            "type": "linked-versions",
            "groupName": "es-ds",
            "components": ["es-ds-styles", "es-ds-components", "es-ds-docs"]
        }
    ],
    "group-pull-request-title-pattern": "chore: release es-ds-styles and es-ds-components ${branch}",
    "bootstrap-sha": "65134ee8cb2806cff99b4924da2d06aa6a45ff17"
}
